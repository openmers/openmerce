{
  "files": {
    "includes": [
      "**",
      "!docs",
      "!.claude",
      "!graphify-out",
      "!.orkestra",
      "!pnpm-lock.yaml",
      "!**/dist",
      "!**/build",
      "!**/.wrangler"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "javascript": { "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" } },
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "overrides": [
    {
      "includes": ["packages/core/**"],
      "linter": {
        "rules": {
          "correctness": { "noNodejsModules": "error" },
          "style": { "noProcessEnv": "error" }
        }
      }
    }
  ]
}
